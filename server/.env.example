PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/credential_dashboard

# Frontend origin(s) allowed by CORS.
# In production, set this to the deployed Vercel frontend URL, e.g.:
# CLIENT_URL=https://your-app.vercel.app
# Multiple origins can be provided as a comma-separated list:
# CLIENT_URL=https://your-app.vercel.app,http://localhost:5173
# If CLIENT_URL is empty/unset, CORS allows all origins (local development default).
CLIENT_URL=