# Server port. Render injects PORT automatically; defaults to 5000 locally.
PORT=5000

# MongoDB connection string.
#
# PRODUCTION (Render): use your MongoDB Atlas URI — NEVER 127.0.0.1.
# Copy it from Atlas → Cluster0 → Connect → Drivers, e.g.:
#
#   mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/credential_dashboard?retryWrites=true&w=majority
#
# - URL-encode the password if it contains special characters.
# - Store the real value ONLY as a Render secret environment variable.
# - Never commit real credentials to Git or frontend code.
#
# LOCAL DEVELOPMENT: either point to a local MongoDB instance, or leave the
# variable unset to run in memory-only mode.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/DATABASE_NAME?retryWrites=true&w=majority

# Frontend origin(s) allowed by CORS.
# In production, set this to the deployed Vercel frontend URL, e.g.:
# CLIENT_URL=https://your-app.vercel.app
# Multiple origins can be provided as a comma-separated list:
# CLIENT_URL=https://your-app.vercel.app,http://localhost:5173
# If CLIENT_URL is empty/unset, CORS allows all origins (local development default).
CLIENT_URL=